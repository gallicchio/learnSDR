  id: digital_constellation_modulator
  parameters:
    affinity: ''
    alias: ''
    comment: 'the Constellation Modulator packs the bits

      into symbols for whatever constellation it is given'
    constellation: constellation
    differential: 'False'
    excess_bw: alpha
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_symbol: sps
    truncate: 'False'
    verbose: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 250
    - 560
    state: enabled
- name: digital_constellation_receiver_cb_24
  id: digital_constellation_receiver_cb
  parameters:
    affinity: ''
    alias: ''
    comment: 'Constellation Receiver = a Costas-style phase loop whose

      error signal is "received symbol minus nearest constellation

      point". Unlike the plain Costas loop (Lesson 19) it works for

      any constellation, including the three rings of 16-QAM.

      Outputs: decided symbol index (byte) and, on the "symbol" port,

      the phase-corrected complex symbol.'
    constellation: constellation
    fmax: '0.1'
    fmin: '-0.1'
    loop_bw: 2*math.pi/100
    maxoutbuf: '0'
    minoutbuf: '0'
    showports: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1260
    - 850
    state: enabled
- name: digital_fll_band_edge_cc_21
  id: digital_fll_band_edge_cc
  parameters:
    affinity: ''
    alias: ''
    comment: Lesson 17
    filter_size: sps*2+1
    improved_loop_filter: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    rolloff: alpha
    samps_per_sym: sps
    type: cc
    w: 2*math.pi/sps/100
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 500
    - 850
    state: enabled
- name: digital_symbol_sync_xx_23
  id: digital_symbol_sync_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Lesson 18. The signal-times-slope TED still works

      for QAM: all rings share the same symbol timing'
    constellation: constellation
    damping: '1.0'
    loop_bw: '0.02'
    max_dev: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    nfilters: nfilts
    osps: '1'
    pfb_mf_taps: rcc_taps
    resamp_type: digital.IR_PFB_MF
    sps: sps
    ted_gain: ted_gain
    ted_type: digital.TED_SIGNAL_TIMES_SLOPE_ML
    type: cc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 960
    - 850
    state: enabled
