- name: blocks_multiply_const_vxx_16
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'keep the peaks of the RRC-shaped signal

      well inside the Pluto''s +/-1 range'
    const: 0.3/np.max(np.abs(constellation.points()))
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 540
    - 560
    state: enabled
- name: blocks_multiply_const_vxx_29
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'scale the ideal points to mean amplitude 1

      (what the AGC gives us)'
    const: 1/np.mean(np.abs(constellation.points()))
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2000
    - 950
    state: enabled
