    coordinate:
    - 460
    - 1100
    state: enabled
- name: blocks_vector_source_x_10
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: the code, over and over, with gaps
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: float
    vector: code + gap
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 780
    state: enabled
- name: fir_filter_xxx_14
  id: fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'correlator = FIR filter with the time-reversed code as taps:

      at each output it slides the code along the input,

      multiplies, and sums (Lesson 22 did this with FFTs)'
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_delay: '0'
    taps: code[::-1]
    type: fff
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 650
    - 800
    state: enabled
- name: fir_filter_xxx_18
  id: fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: '... correlated with the code: no peaks, just noise

      of RMS sqrt(13) x noise. Noise does not "look like" the code;

      this is why correlation finds weak signals (GPS, Lesson 23)'
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_delay: '0'
    taps: code[::-1]
    type: fff
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 650
    - 1100
    state: enabled
- name: import_2
  id: import
  parameters:
