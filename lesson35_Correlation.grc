    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 250
    - 780
    state: enabled
- name: blocks_throttle2_17
  id: blocks_throttle2
  parameters:
    affinity: ''
