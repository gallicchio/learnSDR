- name: digital_constellation_modulator_18
  id: digital_constellation_modulator
  parameters:
    affinity: ''
    alias: ''
    comment: 'QPSK at the same BIT rate:

      2 bits per symbol, so 2*sps samples per symbol'
    constellation: digital.constellation_qpsk().base()
    differential: 'False'
    excess_bw: '0.5'
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_symbol: 2*sps
    truncate: 'False'
    verbose: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 250
    - 650
    state: enabled
- name: fir_filter_xxx_15
  id: fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'GMSK: smooth the bit pulses with a Gaussian

      filter before the FM, so the frequency

      changes gently'
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_delay: '0'
    taps: gauss_taps
    type: fff
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1300
    - 450
    state: enabled
