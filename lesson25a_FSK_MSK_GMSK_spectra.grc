options:
  parameters:
    alias: ''
    author: Claude (Oct 2026), in the style of the learnSDR lessons
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: ''
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: '.:'
    id: lesson25a_FSK_MSK_GMSK_spectra
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: FSK, MSK, GMSK and QPSK spectra (simulation)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
blocks:
- name: bt
  id: variable
  parameters:
    comment: Gaussian filter bandwidth x bit time (GSM uses 0.3)
    value: '0.3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 380
    - 10
    state: enabled
- name: gauss_taps
  id: variable
  parameters:
    comment: Gaussian pulse-shaping filter, 4 bits long
    value: firdes.gaussian(1, sps, bt, 4*sps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 10
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 190
    - 10
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: samples per bit
    value: '16'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 10
    state: enabled
- name: analog_frequency_modulator_fc_13
  id: analog_frequency_modulator_fc
  parameters:
    affinity: ''
    alias: ''
    comment: '2-FSK, modulation index h = 1:

      the two tones are 1 bit-rate apart.

      phase advances by pi*h per bit'
    maxoutbuf: '0'
    minoutbuf: '0'
    sensitivity: math.pi*1.0/sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1300
    - 150
    state: enabled
- name: analog_frequency_modulator_fc_14
  id: analog_frequency_modulator_fc
  parameters:
    affinity: ''
    alias: ''
    comment: 'MSK = FSK with h = 0.5, the smallest h that

      keeps the two tones orthogonal'
    maxoutbuf: '0'
    minoutbuf: '0'
    sensitivity: math.pi*0.5/sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1300
    - 300
    state: enabled
- name: analog_frequency_modulator_fc_16
  id: analog_frequency_modulator_fc
  parameters:
