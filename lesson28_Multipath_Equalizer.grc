options:
  parameters:
    alias: ''
    author: Claude (Oct 2026), in the style of the learnSDR lessons
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: ''
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: '.:'
    id: lesson28_Multipath_Equalizer
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: Multipath and a simple adaptive equalizer (simulation)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
blocks:
- name: alpha
  id: variable
  parameters:
    comment: RRC excess bandwidth
    value: '0.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 380
    - 10
    state: enabled
- name: cma
  id: variable_adaptive_algorithm
  parameters:
    comment: 'Constant Modulus Algorithm: adjust the taps so that

      |output| is always 1 (true for PSK). Needs no training data.'
    cons: constellation
    delta: '10.0'
    ffactor: '0.99'
    modulus: '1'
    step_size: '0.002'
    type: cma
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1250
    - 10
    state: enabled
- name: constellation
  id: variable_constellation
  parameters:
    comment: ''
    const_points: '[-1-1j, -1+1j, 1+1j, 1-1j]'
    dims: '1'
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    type: qpsk
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 10
    state: enabled
- name: echo_amplitude
  id: variable_qtgui_range
  parameters:
    comment: 'relative amplitude of the second path (the echo).

      Start at 0, then raise it and watch the constellations'
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.01'
    stop: '0.9'
    value: '0.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 160
    state: enabled
- name: echo_delay
  id: variable_qtgui_range
  parameters:
    comment: 'delay of the echo in samples (sps = 8 samples per symbol,

      so 6 samples is 3/4 of a symbol)'
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '24'
    value: '6'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 260
    state: enabled
- name: nfilts
  id: variable
  parameters:
    comment: ''
    value: '32'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 470
    - 10
    state: enabled
- name: noise_voltage
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.01'
    stop: '0.5'
    value: '0.05'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 360
    state: enabled
- name: rcc_taps
  id: variable
  parameters:
    comment: matched-filter prototype for the Symbol Sync
    value: firdes.root_raised_cosine(nfilts, nfilts*samp_rate, samp_rate/sps, alpha,
      11*sps*nfilts)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 980
    - 10
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 190
    - 10
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: samples per symbol
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 10
    state: enabled
- name: ted_gain
  id: variable
  parameters:
    comment: see Lesson 18
    value: 1.1*alpha/sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 560
    - 10
    state: enabled
