- name: digital_linear_equalizer_26
  id: digital_linear_equalizer
  parameters:
    adapt_after_training: 'True'
    affinity: ''
    alg: cma
    alias: ''
    comment: '11-tap FIR filter whose taps are adjusted

      continuously by the CMA; input at 2 samples

