- name: digital_costas_loop_cc_27
  id: digital_costas_loop_cc
  parameters:
    affinity: ''
    alias: ''
    comment: 'the equalizer leaves an arbitrary rotation;

      the Costas loop removes it'
    maxoutbuf: '0'
    minoutbuf: '0'
