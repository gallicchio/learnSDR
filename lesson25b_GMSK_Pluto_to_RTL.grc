- name: low_pass_filter_17
  id: low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: 'channel filter: about one bit-rate wide. An FM

      demodulator turns ALL the noise in its input into

      output noise, so cut the bandwidth down first'
    cutoff_freq: samp_rate/sps
    decim: '1'
    gain: '1'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_ccf
    width: samp_rate/sps/2
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 480
    - 760
    state: enabled
