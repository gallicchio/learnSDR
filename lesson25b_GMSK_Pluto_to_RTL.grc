  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1300
    - 1180
    state: enabled
- name: blocks_multiply_const_vxx_12
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'GMSK has constant envelope, so no

      peaks to worry about - just a safe level'
    const: '0.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 400
    state: enabled
- name: dc_blocker_xx_19
  id: dc_blocker_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'the frequency error between Pluto and RTL-SDR

      shows up as a DC offset after FM demodulation;

      this high-pass filter removes it (compare with

      the FLL in Lesson 17)'
    length: '1024'
    long_form: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    type: ff
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 960
    - 780
    state: enabled
- name: digital_binary_slicer_fb_24
  id: digital_binary_slicer_fb
  parameters:
    affinity: ''
    alias: ''
    comment: '> 0 -> 1, < 0 -> 0'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1300
    - 1070
    state: enabled
- name: digital_gmsk_mod_11
  id: digital_gmsk_mod
  parameters:
    affinity: ''
    alias: ''
    bt: bt
    comment: 'GNU Radio''s GMSK modulator: unpack bits,

      Gaussian filter, FM with h = 0.5

      (Lesson 25a builds the same thing from parts)'
    do_unpack: 'True'
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_symbol: sps
    verbose: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 250
    - 400
    state: enabled
- name: digital_symbol_sync_xx_23
  id: digital_symbol_sync_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'bit timing recovery (Lesson 18), float version,

      no matched filter bank needed'
    constellation: digital.constellation_bpsk().base()
    damping: '1.0'
    loop_bw: '0.02'
    max_dev: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    nfilters: '128'
    osps: '1'
    pfb_mf_taps: '[]'
    resamp_type: digital.IR_MMSE_8TAP
    sps: sps
    ted_gain: ted_gain
    ted_type: digital.TED_MUELLER_AND_MULLER
    type: ff
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1000
    - 1050
    state: enabled
