    state: enabled
- name: fir_filter_xxx_25
  id: fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'correlate with the preamble: an FIR filter whose taps are

      the time-reversed conjugate preamble (Lesson 22 did the same

      thing with FFTs). Output = 1 x e^(j*rotation) at a packet start'
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_delay: '0'
    taps: np.conj(preamble[::-1])/len(preamble)
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2150
    - 680
    state: enabled
