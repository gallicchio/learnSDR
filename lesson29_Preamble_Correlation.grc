- name: digital_costas_loop_cc_24
  id: digital_costas_loop_cc
  parameters:
    affinity: ''
    alias: ''
    comment: 'Lesson 19: locks, but at one of FOUR equally

      good angles (0, 90, 180, 270 degrees)'
    maxoutbuf: '0'
    minoutbuf: '0'
    order: constellation.arity()
    use_snr: 'False'
    w: 2*math.pi/100
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
