- name: blocks_moving_average_xx_24
  id: blocks_moving_average_xx
  parameters:
    affinity: ''
    alias: ''
    comment: mean error power over 2000 symbols
    length: '2000'
    max_iter: '4000'
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: 1.0/2000
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2300
    - 500
    state: enabled
- name: blocks_multiply_const_vxx_27
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'GNU Radio''s built-in QPSK points have magnitude 2;

      scale them to the unit magnitude the AGC gives us'
    const: 1/abs(constellation.points()[0])
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1750
    - 700
    state: enabled
- name: blocks_nlog10_ff_25
  id: blocks_nlog10_ff
  parameters:
    affinity: ''
    alias: ''
    comment: 'signal power is 1 after the AGC, so

      SNR (dB) = -10 log10(error power)'
    k: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: '-10'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2550
    - 500
    state: enabled
- name: blocks_sub_xx_22
