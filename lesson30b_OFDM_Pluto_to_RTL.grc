options:
  parameters:
    alias: ''
    author: Claude (Oct 2026), in the style of the learnSDR lessons
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: ''
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: '.:'
    id: lesson30b_OFDM_Pluto_to_RTL
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: OFDM from Pluto to RTL-SDR
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
blocks:
- name: center_freq
  id: variable
  parameters:
    comment: ''
    value: 915e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 800
    - 10
    state: enabled
- name: cp_len
  id: variable
  parameters:
    comment: 'cyclic prefix: the last 16 samples of each

      symbol are copied in front of it'
    value: fft_len//4
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 420
    - 10
    state: enabled
- name: fft_len
  id: variable
  parameters:
    comment: number of sub-carriers (including unused ones)
    value: '64'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 10
    state: enabled
- name: len_tag_key
  id: variable
  parameters:
    comment: name of the tag that marks packet boundaries
    value: '"packet_len"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 680
    - 10
    state: enabled
- name: occupied_carriers
  id: variable
  parameters:
    comment: 48 data carriers (the same layout as Wi-Fi 802.11a)
    value: (list(range(-26, -21)) + list(range(-20, -7)) + list(range(-6, 0)) + list(range(1,
      7)) + list(range(8, 21)) + list(range(22, 27)),)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 160
    state: enabled
- name: packet_len
  id: variable
  parameters:
    comment: payload bytes per packet
    value: '96'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 560
    - 10
    state: enabled
- name: pilot_carriers
  id: variable
  parameters:
    comment: '4 pilot carriers with known symbols, used by

      the receiver to track phase and frequency'
    value: ((-21, -7, 7, 21),)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 260
    state: enabled
- name: pilot_symbols
  id: variable
  parameters:
    comment: ''
    value: ((1, 1, 1, -1),)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 330
    state: enabled
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '49'
    value: '10'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 520
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 190
    - 10
    state: enabled
- name: tx_attenuation
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '89'
    value: '10'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 420
    state: enabled
- name: analog_random_source_x_12
  id: analog_random_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: random bytes
    max: '256'
    maxoutbuf: '0'
    min: '0'
    minoutbuf: '0'
    num_samps: '10000'
    repeat: 'True'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 800
    state: enabled
- name: blocks_multiply_const_vxx_15
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'OFDM has a high peak-to-average ratio:

      keep the average well below the Pluto''s limit'
    const: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 800
    - 800
    state: enabled
- name: blocks_stream_to_tagged_stream_13
  id: blocks_stream_to_tagged_stream
  parameters:
    affinity: ''
    alias: ''
    comment: cut the byte stream into packets
    len_tag_key: len_tag_key
    maxoutbuf: '0'
    minoutbuf: '0'
    packet_len: packet_len
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 250
    - 800
    state: enabled
- name: blocks_tag_debug_23
  id: blocks_tag_debug
  parameters:
    affinity: ''
    alias: ''
    comment: 'prints the rx_len tags (one per received packet)

      to the console'
    display: 'True'
    filter: '""'
    name: '"rx packets"'
    num_inputs: '1'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2250
    - 1150
    state: enabled
- name: blocks_uchar_to_float_21
  id: blocks_uchar_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2250
    - 1020
    state: enabled
- name: digital_ofdm_rx_20
  id: digital_ofdm_rx
  parameters:
    affinity: ''
    alias: ''
    comment: 'OFDM receiver: finds the packet start (Schmidl & Cox

      sync word), corrects the frequency offset, FFT, equalizes

      each carrier with the pilots, decodes header then payload'
    cp_len: cp_len
    fft_len: fft_len
    header_mod: '"BPSK"'
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    occupied_carriers: occupied_carriers
    packet_len_key: '"rx_len"'
    payload_mod: '"QPSK"'
    pilot_carriers: pilot_carriers
    pilot_symbols: pilot_symbols
    scramble_bits: 'False'
    sync_word1: None
    sync_word2: None
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1950
    - 1000
    state: enabled
- name: digital_ofdm_tx_14
  id: digital_ofdm_tx
  parameters:
    affinity: ''
    alias: ''
    comment: 'OFDM transmitter: header (BPSK) + payload (QPSK) symbols

      are put on the sub-carriers, an inverse FFT turns them into

      a time signal, and the cyclic prefix is added'
    cp_len: cp_len
    fft_len: fft_len
    header_mod: '"BPSK"'
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    occupied_carriers: occupied_carriers
    packet_len_key: len_tag_key
    payload_mod: '"QPSK"'
    pilot_carriers: pilot_carriers
    pilot_symbols: pilot_symbols
    rolloff: '0'
    scramble_bits: 'False'
    sync_word1: None
    sync_word2: None
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 780
    state: enabled
- name: iio_pluto_sink_16
  id: iio_pluto_sink
  parameters:
    affinity: ''
    alias: ''
    attenuation1: tx_attenuation
    bandwidth: int(samp_rate)
    buffer_size: '32768'
    comment: ''
    cyclic: 'False'
    filter: ''
    filter_source: '''Auto'''
    fpass: '0'
    frequency: int(center_freq)
    fstop: '0'
    len_tag_key: ''
    samplerate: int(samp_rate)
    type: fc32
    uri: 192.168.2.1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1150
    - 780
    state: enabled
