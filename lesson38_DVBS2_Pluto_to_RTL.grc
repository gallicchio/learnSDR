    state: enabled
- name: digital_costas_loop_cc_31
  id: digital_costas_loop_cc
  parameters:
    affinity: ''
    alias: ''
    comment: 'Lesson 19. The scrambled symbols are still

      plain QPSK, so it locks. Decoding the frames

      needs gr-dvbs2rx, a separate package'
    maxoutbuf: '0'
    minoutbuf: '0'
    order: '4'
    use_snr: 'False'
    w: 2*math.pi/100
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1260
    - 820
    state: enabled
- name: digital_fll_band_edge_cc_28
  id: digital_fll_band_edge_cc
  parameters:
    affinity: ''
    alias: ''
    comment: Lesson 17
    filter_size: sps*2+1
    improved_loop_filter: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    rolloff: rolloff
    samps_per_sym: sps
    type: cc
    w: 2*math.pi/sps/100
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 500
    - 800
    state: enabled
- name: digital_symbol_sync_xx_30
  id: digital_symbol_sync_xx
  parameters:
    affinity: ''
    alias: ''
    comment: Lesson 18
    constellation: digital.constellation_qpsk().base()
    damping: '1.0'
    loop_bw: '0.02'
    max_dev: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    nfilters: nfilts
    osps: '1'
    pfb_mf_taps: rcc_taps
    resamp_type: digital.IR_PFB_MF
    sps: sps
    ted_gain: ted_gain
    ted_type: digital.TED_SIGNAL_TIMES_SLOPE_ML
    type: cc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 960
    - 800
    state: enabled
- name: dtv_dvb_bbheader_bb_14
  id: dtv_dvb_bbheader_bb
  parameters:
    affinity: ''
    alias: ''
    comment: '1. baseband framing: group packets into a 32208-bit

      "baseband frame" with a header (and a CRC per packet)'
    fecblocks: '168'
    framesize1: FECFRAME_NORMAL
    framesize2: FECFRAME_NORMAL
    inband: INBAND_OFF
    maxoutbuf: '0'
    minoutbuf: '0'
    mode: INPUTMODE_NORMAL
    rate1: C1_2
    rate2: C1_3
    rate3: C1_4
    rate4: C1_5_MEDIUM
    rate5: C1_4
    rolloff: RO_0_20
    standard: STANDARD_DVBS2
    tsrate: '4000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 250
    - 480
    state: enabled
- name: dtv_dvb_bbscrambler_bb_15
  id: dtv_dvb_bbscrambler_bb
  parameters:
    affinity: ''
    alias: ''
    comment: '2. scramble with an LFSR (Lesson 21) so the

      bits look random whatever the video does'
    framesize1: FECFRAME_NORMAL
    framesize2: FECFRAME_NORMAL
    maxoutbuf: '0'
    minoutbuf: '0'
    rate1: C1_2
    rate2: C1_3
    rate3: C1_4
    rate4: C1_5_MEDIUM
    rate5: C1_4
    standard: STANDARD_DVBS2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 480
    state: enabled
- name: dtv_dvb_bch_bb_16
  id: dtv_dvb_bch_bb
  parameters:
    affinity: ''
    alias: ''
    comment: '3. outer code: BCH, fixes a few dozen bit errors per frame'
    framesize1: FECFRAME_NORMAL
    framesize2: FECFRAME_NORMAL
    maxoutbuf: '0'
    minoutbuf: '0'
    rate1: C1_2
    rate2: C1_3
    rate3: C1_4
    rate4: C1_5_MEDIUM
    rate5: C1_4
    standard: STANDARD_DVBS2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 770
    - 480
    state: enabled
- name: dtv_dvb_ldpc_bb_17
  id: dtv_dvb_ldpc_bb
  parameters:
    affinity: ''
    alias: ''
    comment: '4. inner code: LDPC rate 1/2, 64800 bits out per

      32208 in. This is what lets DVB-S2 work within

      1 dB of the Shannon limit (Lesson 36 for the idea)'
    constellation: MOD_OTHER
    framesize1: FECFRAME_NORMAL
    framesize2: FECFRAME_NORMAL
    maxoutbuf: '0'
    minoutbuf: '0'
    rate1: C1_2
    rate2: C1_3
    rate3: C1_4
    rate4: C1_5_MEDIUM
    rate5: C1_4
    standard: STANDARD_DVBS2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1020
    - 480
    state: enabled
- name: dtv_dvbs2_interleaver_bb_18
  id: dtv_dvbs2_interleaver_bb
  parameters:
    affinity: ''
    alias: ''
    comment: 5. bit interleaver (nothing to do for QPSK)
    constellation: MOD_QPSK
    framesize: FECFRAME_NORMAL
    maxoutbuf: '0'
    minoutbuf: '0'
    rate1: C1_2
    rate2: C1_5_MEDIUM
    rate3: C1_4
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1270
    - 480
    state: enabled
- name: dtv_dvbs2_modulator_bc_19
  id: dtv_dvbs2_modulator_bc
  parameters:
    affinity: ''
    alias: ''
    comment: 6. bits -> QPSK symbols
    constellation: MOD_QPSK
    framesize: FECFRAME_NORMAL
    interpolation: INTERPOLATION_OFF
    maxoutbuf: '0'
    minoutbuf: '0'
    rate1: C1_2
    rate2: C1_5_MEDIUM
    rate3: C1_4
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1500
    - 480
    state: enabled
- name: dtv_dvbs2_physical_cc_20
  id: dtv_dvbs2_physical_cc
  parameters:
    affinity: ''
    alias: ''
    comment: '7. physical layer: a 90-symbol header (the preamble

      of Lesson 29) that tells the receiver the modulation

      and code rate, pilot blocks every 1440 symbols, and a

      Gold-code scrambling (Lesson 22) of all the symbols'
    constellation: MOD_QPSK
    framesize: FECFRAME_NORMAL
    goldcode: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    pilots: PILOTS_ON
    rate1: C1_2
    rate2: C1_5_MEDIUM
    rate3: C1_4
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1730
    - 480
    state: enabled
- name: fir_filter_xxx_21
  id: fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: '8. root-raised-cosine pulse shaping (Lesson 15). The

      modulator already put a zero between the symbols

      (2 samples per symbol); this filter fills them in'
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_delay: '0'
    taps: rrc_taps
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2000
    - 480
    state: enabled
