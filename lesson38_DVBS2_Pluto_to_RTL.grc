- name: blocks_vector_source_x_13
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: TS packets, over and over
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: byte
    vector: ts_packet
    vlen: '1'
  states:
