options:
  parameters:
    alias: ''
    author: Claude (Oct 2026), in the style of the learnSDR lessons
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: ''
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: '.:'
    id: lesson31_Chirp_FMCW_Radar
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: Chirps and FMCW radar (simulation)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
blocks:
- name: c
  id: variable
  parameters:
    comment: speed of light, m/s
    value: 3e8
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 770
    - 10
    state: enabled
- name: chirp_bandwidth
  id: variable
  parameters:
    comment: the chirp sweeps this far in frequency ...
    value: samp_rate*0.8
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 10
    state: enabled
- name: chirp_period
  id: variable
  parameters:
    comment: '... in this much time (seconds)'
    value: 1e-3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 470
    - 10
    state: enabled
- name: chirp_rate
  id: variable
  parameters:
    comment: Hz per second
    value: chirp_bandwidth/chirp_period
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 600
    - 10
    state: enabled
- name: echo_amplitude
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.01'
    stop: '1'
    value: '0.3'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 260
    state: enabled
- name: noise_voltage
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.01'
    stop: '1'
    value: '0.1'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 360
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 190
    - 10
    state: enabled
- name: target_range
  id: variable_qtgui_range
  parameters:
    comment: 'distance to the target in metres. The echo is

      delayed by 2*range/c; at 1 MS/s one sample is 150 m

      of range, which is why this "radar" only sees things

      tens of km away. A 50 MHz chirp would see 1.5 m.'
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '100'
    stop: 100e3
    value: 30e3
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 160
    state: enabled
- name: analog_sig_source_x_10
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: chirp_bandwidth
    comment: 'instantaneous frequency: a sawtooth from

      -B/2 to +B/2 once per chirp period'
    freq: 1/chirp_period
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: -chirp_bandwidth/2
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_SAW_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 500
    state: enabled
- name: blocks_delay_14
  id: blocks_delay
  parameters:
    affinity: ''
    alias: ''
    comment: 'round trip: 2*range/c seconds'
    delay: int(2*target_range/c*samp_rate)
    maxoutbuf: '0'
    minoutbuf: '0'
    num_ports: '1'
    showports: 'False'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 750
    - 600
    state: enabled
- name: blocks_multiply_conjugate_cc_17
  id: blocks_multiply_conjugate_cc
  parameters:
    affinity: ''
    alias: ''
    comment: '"de-chirp": transmitted x conj(received).

      The product of two chirps offset in time is a

      constant tone at f_beat = chirp_rate * delay'
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1400
    - 500
    state: enabled
- name: blocks_multiply_const_vxx_15
