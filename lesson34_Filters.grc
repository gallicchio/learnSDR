    - 1100
    state: enabled
- name: rational_resampler_xxx_16
  id: rational_resampler_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'rational resampler: x3 up, /2 down = 1.5 MS/s.

      Internally: insert zeros, low-pass, keep 1 in 2,

      all done as one polyphase filter'
    decim: '2'
    fbw: '0'
    interp: '3'
    maxoutbuf: '0'
    minoutbuf: '0'
    taps: '[]'
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 500
    - 1100
    state: enabled
connections:
- - analog_noise_source_x_7
  - '0'
  - blocks_throttle2_8
  - '0'
- - band_pass_filter_11
