- name: digital_ofdm_rx_23
  id: digital_ofdm_rx
  parameters:
    affinity: ''
    alias: ''
    comment: 'OFDM receiver: finds the packet start (Schmidl & Cox

      sync word), corrects the frequency offset, FFT, equalizes

      each carrier with the pilots, decodes header then payload'
    cp_len: cp_len
    fft_len: fft_len
    header_mod: '"BPSK"'
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    occupied_carriers: occupied_carriers
    packet_len_key: '"rx_len"'
    payload_mod: '"QPSK"'
    pilot_carriers: pilot_carriers
    pilot_symbols: pilot_symbols
    scramble_bits: 'False'
    sync_word1: None
    sync_word2: None
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1950
    - 1000
    state: enabled
- name: digital_ofdm_tx_14
  id: digital_ofdm_tx
  parameters:
    affinity: ''
    alias: ''
    comment: 'OFDM transmitter: header (BPSK) + payload (QPSK) symbols

      are put on the sub-carriers, an inverse FFT turns them into

      a time signal, and the cyclic prefix is added'
    cp_len: cp_len
    fft_len: fft_len
    header_mod: '"BPSK"'
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    occupied_carriers: occupied_carriers
    packet_len_key: len_tag_key
    payload_mod: '"QPSK"'
    pilot_carriers: pilot_carriers
    pilot_symbols: pilot_symbols
    rolloff: '0'
    scramble_bits: 'False'
    sync_word1: None
    sync_word2: None
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 780
    state: enabled
