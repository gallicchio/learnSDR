blocks:
- name: dec
  id: variable_cc_decoder_def
  parameters:
    comment: 'Viterbi decoder: finds the bit sequence whose

      encoding is closest to what was received'
    dim1: '1'
    dim2: '1'
    framebits: frame_bits
    k: '7'
    mode: fec.CC_STREAMING
    ndim: '0'
    padding: 'False'
    polys: '[79, 109]'
    rate: '2'
    state_end: '-1'
    state_start: '0'
    value: '"ok"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 400
    state: enabled
- name: enc
  id: variable_cc_encoder_def
  parameters:
    comment: 'rate-1/2, constraint-length-7 convolutional code:

      every input bit produces 2 output bits that depend

      on it and the 6 bits before it (polynomials 79, 109 =

      the NASA/Voyager "K=7" code, also in Wi-Fi and LTE)'
    dim1: '1'
    dim2: '1'
    framebits: frame_bits
    k: '7'
    mode: fec.CC_STREAMING
    ndim: '0'
    padding: 'False'
    polys: '[79, 109]'
    rate: '2'
    state_start: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 260
    state: enabled
- name: frame_bits
  id: variable
  parameters:
    comment: bits per coded frame
    value: '2048'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 10
    state: enabled
- name: noise_voltage
  id: variable_qtgui_range
  parameters:
    comment: 'noise RMS per transmitted +/-1 symbol (real noise, N0 = 2 sigma^2):

      Eb/N0 (dB) = -20*log10(noise_voltage) - 3.  0.5 -> 3 dB, 0.35 -> 6 dB'
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.02'
    stop: '2'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
