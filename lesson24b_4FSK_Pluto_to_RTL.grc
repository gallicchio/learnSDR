- name: analog_quadrature_demod_cf_20
  id: analog_quadrature_demod_cf
  parameters:
    affinity: ''
    alias: ''
    comment: 'FM demodulator, scaled so the four tones

      come out as -3, -1, +1, +3'
    gain: samp_rate/(2*math.pi*deviation)
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 720
    - 920
    state: enabled
