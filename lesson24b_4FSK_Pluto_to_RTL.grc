    id: lesson24b_4FSK_Pluto_to_RTL
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: 4-FSK (as used by FLEX pagers and DMR) from Pluto to RTL-SDR
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    state: enabled
blocks:
- name: center_freq
  id: variable
  parameters:
    comment: ''
    value: 915e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 560
    - 10
    state: enabled
- name: deviation
  id: variable
  parameters:
    comment: the four tones are at -3, -1, +1, +3 times this (Hz)
    value: 10e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 430
    - 10
    state: enabled
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '49'
    value: '10'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 10
    - 260
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 190
    - 10
    state: enabled
- name: samples_per_symbol
  id: variable
  parameters:
    comment: 10 ksymbol/s = 20 kbit/s
    value: '100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 10
    state: enabled
